# --- Google Gemini (pick one path) ---
# Simplest to start: an AI Studio API key (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=
# Optional: shown in the agent's disclaimer/prompt as the app name.
APP_NAME=
# Model override (optional). gemini-2.5-flash is a good cost/quality default.
GEMINI_MODEL=gemini-2.5-flash
# Vertex path instead (uncomment + `gcloud auth application-default login`):
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=<project>
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Phoenix Cloud (free tier @ app.phoenix.arize.com) ---
# Create a Phoenix API key (format px_live_...), NOT an Arize AX key.
PHOENIX_API_KEY=
# REQUIRED: the Hostname from Phoenix → Settings, including the /s/<space> suffix.
# e.g. https://app.phoenix.arize.com/s/your-space  (no /v1/traces suffix)
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT_NAME=grounded-legal-agent

# --- Tools ---
# Free token from courtlistener.com (Profile -> API). Optional; works anonymously too.
COURTLISTENER_TOKEN=

# --- Server ---
PORT=8080
# Comma-separated origins allowed to call the agent. Use specific origins in
# production; "*" (the default) is convenient for local dev only.
ALLOWED_ORIGINS=http://localhost:3000
